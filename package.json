{
  "name": "subzero",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Delegate a skill's work from Claude Code to an isolated pi child.",
  "type": "module",
  "bin": {
    "subzero": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "release:build": "npm run build && node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:branch": "npm run build && node scripts/publish-plugin-branch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/qoherent/sub0.git"
  }
}
